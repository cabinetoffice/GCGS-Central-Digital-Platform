      "pluginVersion": "12.4.1",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "CLOUDWATCH"
          },
          "expression": "fields @timestamp, @log, webaclId, action, clientIp, httpRequest.clientIp, country, httpRequest.country\n| filter webaclId like /$web_acl/\n| filter @log like /$waf_log_group/\n| filter action like /$action_filter/\n| fields coalesce(clientIp, httpRequest.clientIp) as waf_ip, coalesce(country, httpRequest.country) as waf_country\n| filter waf_ip like /$ip_filter/\n| filter waf_country like /$country_filter/\n| stats count() as requests, min(@timestamp) as first_seen, max(@timestamp) as last_seen by waf_ip, waf_country, action\n| sort requests desc\n| limit $top_n",
          "logGroups": [
            {
              "accountId": "GRAFANA_CLOUDWATCH_ACCOUNT_ID",
              "arn": "arn:aws:logs:eu-west-2:GRAFANA_CLOUDWATCH_ACCOUNT_ID:log-group:aws-waf-logs-cdp-sirsi:*",
              "name": "aws-waf-logs-cdp-sirsi"
            },
            {
              "accountId": "GRAFANA_CLOUDWATCH_ACCOUNT_ID",
              "arn": "arn:aws:logs:eu-west-2:GRAFANA_CLOUDWATCH_ACCOUNT_ID:log-group:aws-waf-logs-cdp-sirsi-php:*",
              "name": "aws-waf-logs-cdp-sirsi-php"
            },
            {
              "accountId": "GRAFANA_CLOUDWATCH_ACCOUNT_ID",
              "arn": "arn:aws:logs:eu-west-2:GRAFANA_CLOUDWATCH_ACCOUNT_ID:log-group:aws-waf-logs-cdp-sirsi-fts:*",
              "name": "aws-waf-logs-cdp-sirsi-fts"
            },
            {
              "accountId": "GRAFANA_CLOUDWATCH_ACCOUNT_ID",
              "arn": "arn:aws:logs:eu-west-2:GRAFANA_CLOUDWATCH_ACCOUNT_ID:log-group:aws-waf-logs-cdp-sirsi-tools:*",
              "name": "aws-waf-logs-cdp-sirsi-tools"
            }
          ],
          "queryLanguage": "CWLI",
          "queryMode": "Logs",
          "refId": "A",
          "region": "default"
        }
      ],
      "title": "Top IPs (Requests)",
      "type": "table"
