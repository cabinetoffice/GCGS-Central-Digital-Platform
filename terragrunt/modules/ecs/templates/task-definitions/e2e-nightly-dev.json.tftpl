[
  {
    "name" : "${name}",
    "image" : "${image}:${service_version}",
    "cpu": ${cpu},
    "memory": ${memory},
    "command": ["--filter", "TestCategory=SearchSmokeTests|TestCategory=NoticesSmokeTest"],
    "portMappings": [],
    "logConfiguration": {
      "logDriver" : "awslogs",
      "options": {
        "awslogs-group" : "${lg_name}",
        "awslogs-region" : "${lg_region}",
        "awslogs-stream-prefix" : "${lg_prefix}"
      }
    },
    "environment": [
      { "name" : "RUN_ONCE", "value" : "${run_once}"},
      { "name" : "TEST_ENV", "value" : "${test_env}"},
      { "name" : "TestSettings__FTSPHPUrl", "value" : "https://fts.${public_domain}"},
      { "name" : "TestSettings__OrganisationApiUrl", "value" : "https://organisation.${public_domain}"},
      { "name" : "TestSettings__SearchAPIUrl", "value" : "https://fts-search-api.${public_domain}/"},
      { "name" : "TestSettings__FTSDotnetSearchUrl", "value" : "https://fts-app.${public_domain}/search"},
      { "name" : "TestSettings__TenantApiUrl", "value" : "https://tenant.${public_domain}"},
      { "name" : "TestSettings__UserApiUrl", "value" : "https://fts-user-api.${public_domain}/"},
      { "name" : "TestSettings__SirsiDomain", "value" : "${public_domain}"},
      { "name" : "TestSettings__Headed", "value" : "${test_settings_headed}"},
      { "name" : "TEST_TIMEOUT_SECONDS", "value" : "${test_timeout_seconds}"},
      { "name" : "KILL_AFTER_SECONDS", "value" : "${kill_after_seconds}"},
      { "name" : "TEAMS_NOTIFICATION_ENABLED", "value" : "${teams_notification_enabled}"},
      { "name" : "CLOUDWATCH_METRICS_ENABLED", "value" : "${cloudwatch_metrics_enabled}"}
    ],
    "secrets": [
      { "name" : "TestSettings__Email", "valueFrom" : "${e2e_env_secret_arn}:E2E_EMAIL::"},
      { "name" : "TestSettings__Password", "valueFrom" : "${e2e_env_secret_arn}:E2E_PASSWORD::"},
      { "name" : "TestSettings__SecretKey", "valueFrom" : "${e2e_env_secret_arn}:E2E_SECRET_KEY::"},
      { "name" : "TestSettings__FTSHttpBasicAuthUsername", "valueFrom" : "${fts_secrets_arn}:HTTP_BASIC_AUTH_USER::"},
      { "name" : "TestSettings__FTSHttpBasicAuthPassword", "valueFrom" : "${fts_secrets_arn}:HTTP_BASIC_AUTH_PASS::"},
      { "name" : "TestSettings__FTSHttpBasicAuthEnabled", "valueFrom" : "${fts_secrets_arn}:HTTP_BASIC_AUTH_ENABLED::"},
      { "name" : "TestSettings__SIRSICognitoUsername", "valueFrom" : "${e2e_env_secret_arn}:E2E_COGNITO_USERNAME::"},
      { "name" : "TestSettings__SIRSICognitoPassword", "valueFrom" : "${e2e_env_secret_arn}:E2E_COGNITO_PASSWORD::"},
      { "name" : "TEAMS_WEBHOOK_URL", "valueFrom" : "${e2e_env_secret_arn}:TEAMS_WEBHOOK_URL::"}
    ],
    "volumesFrom": [],
    "mountPoints": [],
    "essential": true
  }
]
