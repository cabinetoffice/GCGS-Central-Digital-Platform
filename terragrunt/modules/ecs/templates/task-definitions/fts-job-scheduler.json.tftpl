[
  {
    "name" : "${name}",
    "image" : "${image}:${service_version}",
    "cpu": ${cpu},
    "memory": ${memory},
    "portMappings": [],
    "logConfiguration": {
      "logDriver" : "awslogs",
      "options": {
        "awslogs-group" : "${lg_name}",
        "awslogs-region" : "${lg_region}",
        "awslogs-stream-prefix" : "${lg_prefix}"
      }
    },
    "environment": [
      { "name" : "ASPNETCORE_ENVIRONMENT", "value" : "${aspcore_environment}"},
      { "name" : "Aws__CloudWatch__LogGroup", "value" : "${lg_name}"},
      { "name" : "Aws__CloudWatch__LogStream", "value" : "${lg_prefix}-serilog"},
      { "name" : "FtsPostgreSQLDatabase__Server", "value" : "${db_address}:${db_port}"},
      { "name" : "FtsPostgreSQLDatabase__Database", "value" : "${db_name}"},
      { "name" : "FtsPostgreSQLDatabase__CommandTimeout", "value" : "${pg_command_timeout}"},
      { "name" : "OpenSearch__Endpoint", "value" : "${opensearch_endpoint}"},
      { "name" : "OpenSearch__DefaultIndex", "value" : "${opensearch_default_index}"},
      { "name" : "FtsLegacy__AppBaseUrl", "value" : "${fts_legacy_app_base_url}"},
      { "name" : "SearchApiClient__BaseUrl", "value" : "${search_api_base_url}"},
      { "name" : "JobScheduler__JobRefreshIntervalInMinutes", "value" : "${job_refresh_interval_in_minutes}"}
    ],
    "secrets": [
      { "name" : "FtsPostgreSQLDatabase__Password", "valueFrom" : "${db_password}"},
      { "name" : "FtsPostgreSQLDatabase__Username", "valueFrom" : "${db_username}"},
      { "name" : "OneLogin__Authority", "valueFrom" : "${onelogin_authority}"},
      { "name" : "OneLogin__ClientId", "valueFrom" : "${onelogin_client_id}"},
      { "name" : "OneLogin__PrivateKey", "valueFrom" : "${onelogin_private_key}"}
    ],
    "volumesFrom": [],
    "mountPoints": [],
    "essential": true
  }
]
