{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Archive images not pulled in ${not_pulled_days} days",
      "selection": {
        "tagStatus": "any",
        "countType": "sinceImagePulled",
        "countUnit": "days",
        "countNumber": ${not_pulled_days}
      },
      "action": {
        "type": "transition",
        "targetStorageClass": "archive"
      }
    },
    {
      "rulePriority": 2,
      "description": "Expire images archived for more than ${archived_days} days",
      "selection": {
        "tagStatus": "any",
        "storageClass": "archive",
        "countType": "sinceImageTransitioned",
        "countUnit": "days",
        "countNumber": ${archived_days}
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
